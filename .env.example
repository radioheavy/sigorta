# ===========================================
# KFZ Versicherung Vergleich — Ortam Degiskenleri
# ===========================================
# Bu dosyayi kopyalayip .env olarak kaydedin:
#   cp .env.example .env

# ----- Veritabani -----
# PostgreSQL baglanti URL'i
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sigorta?schema=public"

# ----- Redis -----
# Redis baglanti URL'i (tarife cache icin)
REDIS_URL="redis://localhost:6379"

# ----- Session -----
# iron-session sifreleme anahtari
# ONEMLI: Production'da mutlaka degistirin! (min 32 karakter)
SESSION_SECRET="change_this_to_a_random_32_char_string_in_production"

# ----- CRM -----
# CRM webhook endpoint (opsiyonel)
# Iletisim talebi olusturuldiginda bu URL'e POST gonderilir
CRM_WEBHOOK_URL=""

# ----- WhatsApp -----
# Danismanin WhatsApp telefon numarasi (uluslararasi format)
NEXT_PUBLIC_WHATSAPP_PHONE="+4915123456789"

# ----- Telegram -----
# Telegram bot kullanici adi (@'siz)
NEXT_PUBLIC_TELEGRAM_BOT="sigortabot"
